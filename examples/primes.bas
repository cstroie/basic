10 INPUT "HOW MANY PRIMES? ", N
20 DIM PR(N)
30 E=0
40 P=2
50 WHILE E<N
60     F=0
70     FOR C=2 TO SQR(P)
80         IF P MOD C==0 THEN F=1: EXIT
90     NEXT C
100    IF F==0 THEN PR[E+1]=P:E=E+1
110    P=P+1
120 END WHILE
130 PRINT "THE FIRST ";N;" PRIMES ARE:"
140 FOR I=1 TO N
150     PRINT PR[I]
160 NEXT I
