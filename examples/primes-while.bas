10 REM FIRST N PRIME NUMBERS
20 INPUT "HOW MANY PRIMES"; N
30 DIM PR(N)
40 E = 0 : P = 2
50 WHILE E < N
60 F = 0
70 FOR C = 2 TO SQR(P)
80 IF P MOD C = 0 THEN F = 1 : EXIT FOR
90 NEXT C
100 IF F = 0 THEN E = E + 1 : PR(E) = P
110 P = P + 1
120 WEND
130 PRINT "THE FIRST "; N; " PRIMES:"
140 FOR I = 1 TO N : PRINT PR(I); " "; : NEXT I
150 PRINT
