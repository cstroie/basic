10 REM BUBBLE SORT USING READ/DATA
20 DIM A(9)
30 FOR I = 0 TO 9 : READ A(I) : NEXT I
40 FOR I = 0 TO 8
50 FOR J = 0 TO 8 - I
60 IF A(J) > A(J + 1) THEN T = A(J) : A(J) = A(J + 1) : A(J + 1) = T
70 NEXT J
80 NEXT I
90 FOR I = 0 TO 9 : PRINT A(I); " "; : NEXT I
100 PRINT
